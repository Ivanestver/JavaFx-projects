<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.wordscloud.viewwords.AddNewWordController">
   <children>
      <Button fx:id="addWordBtn" layoutX="201.0" layoutY="316.0" mnemonicParsing="false" onAction="#onAddWordBtnClicked" text="Add" />
      <Button fx:id="cancelBtn" layoutX="351.0" layoutY="316.0" mnemonicParsing="false" onAction="#onCancelClicked" text="Cancel" />
      <Label layoutX="51.0" layoutY="58.0" text="Word" />
      <TextField fx:id="wordTextField" layoutX="120.0" layoutY="54.0" />
      <VBox fx:id="translationsBox" layoutX="36.0" layoutY="138.0" prefHeight="137.0" prefWidth="168.0">
         <children>
            <TextField />
            <TextField />
            <TextField />
         </children>
      </VBox>
      <Label layoutX="35.0" layoutY="111.0" text="Translations" />
      <Label layoutX="335.0" layoutY="111.0" text="Examples" />
      <VBox fx:id="examplesBox" layoutX="335.0" layoutY="138.0" prefHeight="137.0" prefWidth="168.0">
         <children>
            <TextField />
            <TextField />
            <TextField />
         </children>
      </VBox>
      <Button fx:id="addTranslationBtn" layoutX="8.0" layoutY="138.0" mnemonicParsing="false" onAction="#onAddTranslationBtnClicked" text="+" />
      <Button fx:id="removeTranslationBtn" layoutX="9.0" layoutY="164.0" mnemonicParsing="false" onAction="#onRemoveTranslationBtnClicked" text="-" />
      <Button fx:id="addExampleBtn" layoutX="309.0" layoutY="138.0" mnemonicParsing="false" onAction="#onAddExampleBtnClicked" text="+" />
      <Button fx:id="removeExampleBtn" layoutX="310.0" layoutY="164.0" mnemonicParsing="false" onAction="#onRemoveExampleBtnClicked" text="-" />
   </children>
</AnchorPane>
