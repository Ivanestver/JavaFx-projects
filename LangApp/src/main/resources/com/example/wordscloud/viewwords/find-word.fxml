<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox prefHeight="480.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.wordscloud.viewwords.FindWordController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label text="Search" />
            <TextField fx:id="searchField" onKeyTyped="#onKeyTyped" />
         </children>
         <padding>
            <Insets left="10.0" />
         </padding>
      </HBox>
      <ListView fx:id="wordsList" prefHeight="386.0" prefWidth="640.0" />
   </children>
</VBox>
