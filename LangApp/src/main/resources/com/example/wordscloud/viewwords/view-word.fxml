<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.wordscloud.viewwords.UpdateWordController">
   <children>
      <Label layoutX="76.0" layoutY="60.0" text="Word" />
      <Label layoutX="76.0" layoutY="115.0" text="Translations" />
      <Label layoutX="382.0" layoutY="115.0" text="Examples" />
      <TextField fx:id="wordTextField1" layoutX="144.0" layoutY="56.0" />
      <VBox fx:id="translationsBox1" layoutX="76.0" layoutY="140.0" prefHeight="200.0" prefWidth="100.0" />
      <VBox fx:id="examplesBox1" layoutX="382.0" layoutY="140.0" prefHeight="200.0" prefWidth="100.0" />
      <Button fx:id="addWordBtn1" layoutX="102.0" layoutY="340.0" mnemonicParsing="false" onAction="#onAddWordBtnClicked" text="Add" />
      <Button fx:id="cancelBtn1" layoutX="390.0" layoutY="340.0" mnemonicParsing="false" onAction="#onCancelClicked" text="Cancel" />
      <Button layoutX="47.0" layoutY="140.0" mnemonicParsing="false" onAction="#onAddTranslationBtnClicked" text="+" />
      <Button layoutX="48.0" layoutY="167.0" mnemonicParsing="false" onAction="#onRemoveTranslationBtnClicked" text="-" />
      <Button layoutX="356.0" layoutY="141.0" mnemonicParsing="false" onAction="#onAddExampleBtnClicked" text="+" />
      <Button layoutX="357.0" layoutY="168.0" mnemonicParsing="false" onAction="#onRemoveExampleBtnClicked" text="-" />
   </children>
</AnchorPane>
